{
  "name": "promptdown",
  "displayName": "promptdown",
  "description": "极简标记语言 promptdown（.pd）：兼容 markdown 风格，可转 JSON，提供 VSCode 语法高亮与 pd2json CLI",
  "version": "0.6.0",
  "publisher": "andares",
  "license": "MIT",
  "icon": "icons/pd-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:promptdown",
    "onDidOpenTextDocument",
    "onDidChangeTextDocument",
    "onCommand:promptdown.pd2json",
    "onCommand:promptdown.tab"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andares/promptdown.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "prompt",
    "markup",
    "json",
    "language"
  ],
  "bin": {
    "pd2json": "./dist/cli.js",
    "pdformat": "./dist/format-cli.js",
    "hx-install": "./scripts/hx-install.mjs",
    "wsl-install": "./scripts/wsl-install.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "promptdown.pd2json",
        "title": "pd2json: 将当前 PD 文档解析为 JSON（新开 Untitled 文件）"
      }
    ],
    "keybindings": [
      {
        "command": "promptdown.tab",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == promptdown && !editorReadonly && !suggestWidgetVisible && !inSnippets && !inlineSuggestionVisible && !hasOtherSuggestions"
      }
    ],
    "languages": [
      {
        "id": "promptdown",
        "aliases": [
          "promptdown",
          "Promptdown"
        ],
        "extensions": [
          ".pd"
        ],
        "icon": {
          "light": "./icons/pd-icon.png",
          "dark": "./icons/pd-icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "promptdown",
        "scopeName": "source.pd",
        "path": "./syntaxes/pd.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.json": "json",
          "source.json.comments": "jsonc",
          "source.python": "python",
          "source.shell": "shellscript",
          "text.html.derivative": "html",
          "source.css": "css",
          "source.yaml": "yaml",
          "source.sql": "sql",
          "source.go": "go",
          "source.php": "php",
          "source.elixir": "elixir",
          "source.fish": "fish",
          "source.cs": "csharp",
          "source.rescript": "rescript",
          "source.wgsl": "wgsl",
          "source.rust": "rust",
          "source.scala": "scala",
          "source.gleam": "gleam",
          "source.cpp": "cpp",
          "source.moonbit": "moonbit"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "promptdown-icons",
        "label": "promptdown Icons",
        "path": "./theme/pd-icon-theme.json"
      }
    ],
    "configuration": {
      "title": "promptdown",
      "properties": {
        "promptdown.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "untitled / 未知扩展名等弱语法文件中出现 //!pd 段标记行时，自动把文档语言切换为 promptdown（获得高亮与格式化）。有自身语法的文件（md/js 等）不受影响。"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "package": "vsce package --no-dependencies",
    "release": "node ./scripts/publish.mjs",
    "release-all": "node ./scripts/publish.mjs all",
    "tag-current": "node ./scripts/tag-current.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "wsl-install": "node ./scripts/wsl-install.mjs",
    "hx-install": "node ./scripts/hx-install.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
