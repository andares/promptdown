{
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "**", "close": "**" },
    { "open": "`", "close": "`" }
  ],
  "surroundingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "**", "close": "**" },
    { "open": "`", "close": "`" }
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*-\\s*$",
      "action": { "indent": "none", "appendText": "" }
    },
    {
      "beforeText": "^\\s*-\\s+.*$",
      "action": { "indent": "none", "appendText": "- " }
    }
  ]
}
