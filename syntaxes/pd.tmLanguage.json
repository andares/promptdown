{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "promptdown",
  "scopeName": "source.pd",
  "patterns": [
    { "include": "#code-block" },
    { "include": "#section" },
    { "include": "#separator" },
    { "include": "#literal-colon" },
    { "include": "#ref" },
    { "include": "#key" },
    { "include": "#info" },
    { "include": "#item" }
  ],
  "repository": {
    "code-block": {
      "comment": "``` 围栏代码块：转 JSON 为 Code 对象（lang 可空，body 为整个文本）",
      "begin": "^(\\s*)(```)([A-Za-z0-9_+-]*)?.*$",
      "end": "^\\s*```\\s*$",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.fenced.pd" },
        "3": { "name": "entity.name.tag.pd" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.fenced.pd" }
      },
      "name": "markup.fenced_code.block.pd"
    },
    "section": {
      "comment": "//!pd <name> 段标记（markup.heading：主题标题色 + 粗体，与 key 区分）",
      "match": "^\\s*(//!pd)(\\s+[^\\s]+)?.*$",
      "captures": {
        "1": { "name": "markup.heading.pd" },
        "2": { "name": "entity.name.section.pd" }
      }
    },
    "separator": {
      "comment": "--- 分隔线",
      "match": "^\\s*(---)\\s*$",
      "captures": {
        "1": { "name": "punctuation.separator.pd" }
      }
    },
    "ref": {
      "comment": ":refname 引用（前后带空格；引用名不能以 - 开头）",
      "match": "(?:^|\\s)(:[^\\s-][^\\s]*)(?=\\s|$)",
      "captures": {
        "1": { "name": "markup.quote.pd" }
      }
    },
    "literal-colon": {
      "comment": ":- / ：- 普通冒号标记：整行不识别键值，本标记也不是引用",
      "match": "[：:]-",
      "name": "string.unquoted.pd"
    },
    "key": {
      "comment": "键值：含 :- / ：- 的行不识别键值；否则仅第一个半角冒号为分隔符",
      "match": "^(?!.*[：:]-)(\\s*)(-\\s+)?([^\\s:][^:]*)(:)(?=\\s|$)",
      "captures": {
        "2": { "name": "punctuation.definition.list.pd" },
        "3": { "name": "entity.name.tag.pd" },
        "4": { "name": "punctuation.definition.key-value.pd" }
      }
    },
    "info": {
      "comment": "Info 默认键（Info1/Info2...）",
      "match": "^(?!.*[：:]-)(\\s*)(-\\s+)?(Info\\d+)(:)(?=\\s|$)",
      "captures": {
        "2": { "name": "punctuation.definition.list.pd" },
        "3": { "name": "support.constant.pd" },
        "4": { "name": "punctuation.definition.key-value.pd" }
      }
    },
    "item": {
      "comment": "- 序列项",
      "match": "^(\\s*)(-\\s+)",
      "captures": {
        "2": { "name": "punctuation.definition.list.pd" }
      }
    }
  }
}
